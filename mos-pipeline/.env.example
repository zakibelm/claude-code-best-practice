# =============================================================================
# MOS v4.1-RC1 — Environment Variables
# Copy this file to .env and fill in your values. NEVER commit .env.
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase — database and storage backend
# ---------------------------------------------------------------------------

# Full URL of your Supabase project (e.g. https://xxxx.supabase.co)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Service role key — server-side only, full DB access. Never expose to clients.
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Anon (public) key — safe for client-side read-only use with RLS enabled.
SUPABASE_ANON_KEY=your-supabase-anon-key

# ---------------------------------------------------------------------------
# Notion — content source of truth
# ---------------------------------------------------------------------------

# Notion integration token (Internal Integration → "Your integrations")
NOTION_API_KEY=secret_your_notion_integration_token

# ID of the Notion database that holds video production records
NOTION_DATABASE_ID=your-notion-database-id

# ---------------------------------------------------------------------------
# OpenRouter — LLM gateway for script generation
# ---------------------------------------------------------------------------

# API key from openrouter.ai
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key

# Model to use for video script generation (e.g. anthropic/claude-sonnet-4-6)
OPENROUTER_MODEL=anthropic/claude-sonnet-4-6

# Optional: path to a custom system prompt file (overrides built-in prompt)
# VIDEO_SCRIPT_SYSTEM_PROMPT=./prompts/video-script-agent.md

# ---------------------------------------------------------------------------
# ComfyUI — reference image generation
# ---------------------------------------------------------------------------

# Base URL of your ComfyUI instance (no trailing slash)
COMFYUI_BASE_URL=http://YOUR_COMFYUI_HOST:8188

# ---------------------------------------------------------------------------
# fal.ai — AI video generation
# ---------------------------------------------------------------------------

# API key from fal.ai dashboard
FAL_API_KEY=your-fal-ai-api-key

# fal.ai model to use for image-to-video generation
# Supported: fal-ai/kling-video/v1.6/standard/image-to-video
#            fal-ai/kling-video/v1.6/pro/image-to-video
#            fal-ai/minimax-video/image-to-video
#            fal-ai/luma-dream-machine/image-to-video
FAL_VIDEO_MODEL=fal-ai/kling-video/v1.6/standard/image-to-video

# ---------------------------------------------------------------------------
# Blotato — social media scheduling and publishing
# ---------------------------------------------------------------------------

# API key from Blotato dashboard
BLOTATO_API_KEY=your-blotato-api-key

# ---------------------------------------------------------------------------
# Webhooks and n8n
# ---------------------------------------------------------------------------

# Shared secret added to all internal webhook calls (X-MOS-Secret header)
# Generate with: openssl rand -hex 32
MOS_WEBHOOK_SECRET=your-webhook-secret-min-32-chars

# Public base URL where n8n webhooks are reachable from the internet
# Used by fal.ai to send completion callbacks
PUBLIC_WEBHOOK_BASE_URL=https://your-n8n-domain.com

# Base URL of your n8n instance (internal, for self-referencing webhook URLs)
N8N_BASE_URL=https://your-n8n-domain.com
